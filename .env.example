# Copy to .env and fill in only what you need. `docker compose up` reads
# this file automatically; every value below is optional — the demo runs
# with none of them set (mock LLM, local workspace only).
# See docs/deployment.md for the full walkthrough.

# --- Real LLM instead of the deterministic mock (optional) ---
# CONTRACTGUARD_LLM_PROVIDER=openai
# CONTRACTGUARD_LLM_API_KEY=sk-...
# CONTRACTGUARD_LLM_BASE_URL=https://api.openai.com/v1
# CONTRACTGUARD_LLM_MODEL=gpt-4o-mini

# --- Remote repositories / draft-PR publishing demo (optional, FR-027) ---
# Master key encrypting stored GitHub tokens at rest. Generate with:
#   openssl rand -base64 32
# CONTRACTGUARD_CREDENTIAL_KEY=

# --- Audit trail principal shown on every recorded entry (optional, FR-025) ---
# CONTRACTGUARD_AUDIT_PRINCIPAL=local-operator

# --- Point tracing at a real OpenTelemetry collector instead of the log (optional, FR-029) ---
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
