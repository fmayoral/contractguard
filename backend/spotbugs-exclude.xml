<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2 fire on every record or class exposing a
    List/Map/Instant field. Domain types use defensive copies where mutation
    matters; the blanket warning on immutable collections is noise.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
